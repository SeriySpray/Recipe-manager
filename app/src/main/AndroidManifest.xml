<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Recipemanager"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add Recipe Activity -->
        <activity
            android:name=".ui.add.AddRecipeActivity"
            android:exported="false"
            android:label="@string/add_recipe_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Edit Recipe Activity -->
        <activity
            android:name=".ui.edit.EditRecipeActivity"
            android:exported="false"
            android:label="@string/edit_recipe_title"
            android:parentActivityName=".ui.detail.RecipeDetailActivity" />

        <!-- Search Activity -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:label="@string/search_title"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- Recipe Detail Activity -->
        <activity
            android:name=".ui.detail.RecipeDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

    </application>

</manifest>